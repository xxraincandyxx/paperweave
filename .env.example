# 复制为 .env。真实密钥只放本机，不要提交。
# 填主办方提供的 Base URL（可含 /v1），程序追加 /chat/completions。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# DeepSeek V4 Pro 的精确模型 ID 必须以主办方验收通知为准，不根据展示名猜测。
LLM_MODEL=REPLACE_WITH_ORGANIZER_MODEL_ID
LLM_MAX_TOKENS=5000
LLM_TIMEOUT=180
LLM_RETRIES=2
CHUNK_CHARS=10000
# 将原 PDF 内嵌进看板；设为 0 仍保留页码、原文和证据片段。
EMBED_PDF=1
